{
  "name": "roll-and-run-challenge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cf:kv": "wrangler kv namespace create dice-run-store",
    "cf:secret": "wrangler secret put STRAVA_CLIENT_ID && wrangler secret put STRAVA_CLIENT_SECRET && wrangler secret put OFFICE_PUBLISH_TOKEN",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@hono/node-server": "^1.19.6",
    "@tailwindcss/vite": "4.1.14",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "hono": "^4.10.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "latest",
    "tailwindcss": "4.1.14"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "^24.10.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "tsx": "^4.20.6",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "7.3.6",
    "wrangler": "^4.117.0"
  }
}

# Strava API app credentials from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Local: go through Vite so /api is same-origin.
# Production Worker example:
# STRAVA_REDIRECT_URI=https://dice-run-challenge-api.<account>.workers.dev/api/auth/callback
STRAVA_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Where to send users after OAuth completes
# Local:
APP_ORIGIN=http://localhost:5173/dice_run_challenge/
# Production:
# APP_ORIGIN=https://kurtosys-jasonrenaud.github.io/dice_run_challenge/

# Frontend API base (empty = same origin / Vite proxy)
# VITE_API_BASE_URL=https://dice-run-challenge-api.<account>.workers.dev

# Optional API port (default 8787)
API_PORT=8787

# Optional extra CORS origins (comma-separated)
# ALLOWED_ORIGINS=https://kurtosys-jasonrenaud.github.io,http://localhost:5173
